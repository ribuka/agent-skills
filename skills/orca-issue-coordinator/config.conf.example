# Copy to config.conf (personal, git-ignored). Command-line flags override it.
# Unset keys keep the default.

# Implementation workers (implement-review-merge steps 1-7)
CLAUDE_IMPL_MODEL=opus
CLAUDE_IMPL_EFFORT=medium
CODEX_IMPL_MODEL=gpt-6.1-sol
CODEX_IMPL_EFFORT=medium

# Merge-preparation workers (implement-review-merge steps 8-9)
CLAUDE_MERGE_MODEL=sonnet
CLAUDE_MERGE_EFFORT=medium
CODEX_MERGE_MODEL=gpt-6.1-sol
CODEX_MERGE_EFFORT=medium

# Maximum number of workers running at once (implementation and merge
# preparation combined); an integer >= 1. Use 1 to run Issues one at a time.
MAX_WORKERS=3

# Conversation size (tokens) at or above which a worker stopped by the quota
# pause is resumed by a fresh worker instead of in its own conversation; an
# integer >= 1.
FRESH_WORKER_CONTEXT_TOKENS=200000
