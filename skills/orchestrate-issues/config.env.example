# Copy to config.env (personal, git-ignored) or to <repo>/.orchestrate-issues.env
# (per project). Command-line flags override both. Unset keys keep the default.

# Implementation workers (implement-review-merge steps 1-7)
IMPL_MODEL=opus
IMPL_EFFORT=medium

# Merge-preparation workers (implement-review-merge steps 8-9)
MERGE_MODEL=sonnet
MERGE_EFFORT=medium
