# Defaults for pr-cross-review. This file is the single source of these values:
# the scripts have no built-in fallbacks and stop if a key is missing.
# Command-line options (--model, --effort, ...) override the values here.

# Language the reviewer writes the review comment in.
REVIEW_LANGUAGE=Japanese
# Maximum number of cross-reviews (Codex + Claude combined) per pull request.
MAX_REVIEWS=3
# Directory the reviewer writes the comment body file to before posting
# (<dir>/pr-<number>-review-<agent>.md). Relative paths start at the repository root.
REVIEW_BODY_DIR=tmp
# What to do when that file would not be ignored by git: error | warn
REVIEW_BODY_NOT_IGNORED=error
# Make post_pr_comment.sh reject a body file other than that one: true | false
REVIEW_BODY_PATH_ENFORCED=true

# Codex reviewer (run_codex_review.sh)
CODEX_MODEL=gpt-6.1-sol
CODEX_EFFORT=medium
# read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write
# Only applies when CODEX_SANDBOX=workspace-write. post_pr_comment.sh needs network access.
CODEX_NETWORK_ACCESS=true
# Hard upper bound on the whole `codex exec` run (exit 124 on expiry).
CODEX_TIMEOUT_SECONDS=1800
# Kill `codex exec` if it emits no progress for this long (exit 125).
CODEX_HEARTBEAT_TIMEOUT_SECONDS=600

# Claude reviewer (run_claude_review.sh)
CLAUDE_MODEL=opus
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# acceptEdits | auto | bypassPermissions | manual | dontAsk | plan
CLAUDE_PERMISSION_MODE=bypassPermissions
